# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Database ---
DATABASE_URL=postgresql://kbju:kbju@localhost:5432/kbju_tracker?schema=public

# --- Speech-to-text (OpenAI Whisper) ---
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# --- LLM parsing / vision (Anthropic Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Nutrition databases ---
# Primary source: USDA FoodData Central (free, https://fdc.nal.usda.gov/api-key-signup.html)
USDA_FDC_API_KEY=
# Optional secondary source: FatSecret Platform API (OAuth2 client credentials)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# --- Payments ---
# YooKassa (or another Telegram Payments provider) provider token issued by BotFather
TELEGRAM_PAYMENTS_PROVIDER_TOKEN=
# Set to "true" to sell subscriptions for Telegram Stars (XTR) instead of a fiat provider token
USE_TELEGRAM_STARS=false

# --- Trial ---
TRIAL_DAYS=3
TRIAL_MAX_RECOGNITIONS=10

# --- Subscription prices (minor units, e.g. kopecks, ignored for Stars) ---
PRICE_MONTH=29900
PRICE_QUARTER=79900
PRICE_YEAR=249900
CURRENCY=RUB

LOG_LEVEL=info
